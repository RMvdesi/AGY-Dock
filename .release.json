{
  "product": "agy-plugin-manager",
  "siteUrl": "https://ahmustudyhelper.xyz",
  "releaseRepository": "haoan33/AGY-Plugin-Manager",
  "versionFiles": [
    { "path": "VERSION", "format": "text" },
    { "path": "AGY-Launcher/desktop/core.py", "format": "python", "key": "APP_VERSION" }
  ],
  "targets": [
    {
      "platform": "windows",
      "arch": "x64",
      "runner": "windows-latest",
      "commands": [
        ["python", "-m", "pip", "install", "--quiet", "PySide6", "pyinstaller"],
        ["powershell", "-NoProfile", "-Command", "if (-not (Get-Command ISCC.exe -ErrorAction SilentlyContinue) -and -not (Test-Path 'C:\\Program Files (x86)\\Inno Setup 6\\ISCC.exe') -and -not (Test-Path \"$env:LOCALAPPDATA\\Programs\\Inno Setup 6\\ISCC.exe\")) { choco install innosetup -y --no-progress }"],
        ["python", "-m", "unittest", "discover", "-s", "AGY-Launcher/tests", "-v"],
        ["node", "--test", "AGY-Launcher/tests/process-manager.test.mjs"],
        ["python", "AGY-Launcher/scripts/build_release.py"]
      ],
      "artifact": "AGY-Launcher/dist/AGY-Plugin-Manager-Setup-v{version}.exe"
    }
  ]
}
