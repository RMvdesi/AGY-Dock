{
  "product": "agy-plugin-manager",
  "siteUrl": "https://www.haoanlab.xyz",
  "oidcAudience": "https://ahmustudyhelper.xyz",
  "releaseRepository": "haoan33/AGY-Plugin-Manager",
  "versionFiles": [
    { "path": "VERSION", "format": "text" },
    { "path": "package.json", "format": "json", "key": "version" },
    { "path": "src-tauri/Cargo.toml", "format": "toml", "key": "package.version" },
    { "path": "src-tauri/tauri.conf.json", "format": "json", "key": "version" }
  ],
  "targets": [
    {
      "platform": "windows",
      "arch": "x64",
      "runner": "windows-latest",
      "commands": [
        ["npm", "ci"],
        ["npx", "tsc", "--noEmit"],
        ["npm", "run", "build"],
        ["cargo", "test", "--manifest-path", "src-tauri/Cargo.toml"],
        ["npm", "run", "tauri", "--", "build", "--target", "x86_64-pc-windows-msvc"]
      ],
      "artifact": "dist-release/AGY-Plugin-Manager-Setup-v{version}.exe"
    }
  ]
}
